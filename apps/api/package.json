{
  "name": "@coffee-catalog/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./catalog": "./src/catalog.ts",
    "./db": "./src/db.ts",
    "./seed": "./src/seed.ts"
  },
  "scripts": {
